{
  "name": "haber-takip",
  "version": "1.1.0",
  "description": "Haber Takip Uygulaması",
  "main": "main.js",
  "author": "Ezequiel Sarser",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder--publish never",
    "build:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.habertakip.desktop",
    "productName": "Haber Takip",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "iconv-lite": "^0.7.3",
    "rss-parser": "^3.13.0"
  }
}
