<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <title>Haber Takip</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Segoe UI", Arial, sans-serif;
      background: #f4f6f8;
      color: #1a1a1a;
      transition: background 0.3s, color 0.3s;
    }
    .modal-overlay {
      display: none;
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.5);
      align-items: center;
      justify-content: center;
      z-index: 1000;
    }
    .modal-overlay.open {
      display: flex;
    }

    /* ================ OZELLIK 4: KARANLIK MOD ================ */
    body.dark-mode {
      background: #121212;
      color: #e8e8e8;
    }
    body.dark-mode .top-bar,
    body.dark-mode .tabs,
    body.dark-mode .news-card,
    body.dark-mode .modal-content {
      background: #1e1e1e;
      color: #e8e8e8;
      border-color: #333;
    }
    body.dark-mode .tab-btn {
      background: #2a2a2a;
      color: #e8e8e8;
    }
    body.dark-mode .tab-btn.active {
      background: #4a90e2;
      color: #fff;
    }
    body.dark-mode input,
    body.dark-mode select {
      background: #2a2a2a;
      color: #e8e8e8;
      border-color: #444;
    }
    body.dark-mode .news-snippet { color: #bbb; }
    body.dark-mode .news-date { color: #999; }
    body.dark-mode .news-card.read { opacity: 0.5; }

    /* ================ UST BAR ================ */
    .top-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 16px;
      background: #fff;
      border-bottom: 1px solid #ddd;
      flex-wrap: wrap;
    }
    .top-bar h1 {
      font-size: 18px;
      margin: 0;
      margin-right: 10px;
      white-space: nowrap;
    }
    #searchInput, #sourceFilter {
      padding: 8px 10px;
      border: 1px solid #ccc;
      border-radius: 6px;
      font-size: 14px;
    }
    #searchInput { flex: 1; min-width: 150px; }
    #sourceFilter { min-width: 140px; }

    button {
      cursor: pointer;
      border: none;
      border-radius: 6px;
      padding: 8px 14px;
      font-size: 14px;
      background: #eee;
      transition: background 0.2s;
    }
    button:hover { filter: brightness(0.95); }

    .btn-icon { font-size: 16px; padding: 8px 10px; }
    .btn-primary { background: #4a90e2; color: #fff; }
    .btn-warning { background: #f5a623; color: #fff; }
    .btn-danger { background: #e04b4b; color: #fff; }

    /* ================ KATEGORI SEKMELERI ================ */
    .tabs {
      display: flex;
      gap: 6px;
      padding: 10px 16px;
      background: #fff;
      border-bottom: 1px solid #ddd;
      overflow-x: auto;
    }
    .tab-btn {
      white-space: nowrap;
      background: #eef1f4;
      padding: 8px 14px;
      border-radius: 20px;
      font-weight: 500;
    }
    .tab-btn.active {
      background: #4a90e2;
      color: #fff;
    }

    /* ================ DURUM CUBUGU ================ */
    #status {
      padding: 8px 16px;
      font-size: 13px;
      color: #666;
      background: #f0f0f0;
    }
    body.dark-mode #status {
      background: #1a1a1a;
      color: #aaa;
    }

    /* ================ HABER LISTESI ================ */
    #newsList {
      padding: 16px;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 14px;
    }
    .news-card {
      background: #fff;
      border-radius: 10px;
      padding: 14px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.08);
      display: flex;
      flex-direction: column;
      gap: 6px;
      border: 1px solid transparent;
    }
    .news-card.read { opacity: 0.55; }
    .news-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .news-source {
      font-size: 12px;
      font-weight: 600;
      color: #4a90e2;
      text-transform: uppercase;
    }
    .star-btn {
      background: none;
      font-size: 18px;
      padding: 2px 6px;
    }
    .news-title {
      font-size: 15px;
      font-weight: 600;
      color: inherit;
      text-decoration: none;
      line-height: 1.4;
    }
    .news-title:hover { text-decoration: underline; }
    .news-date { font-size: 12px; color: #888; }
    .news-snippet {
      font-size: 13px;
      color: #555;
      margin: 0;
      line-height: 1.4;
    }
    .empty-msg {
      grid-column: 1 / -1;
      text-align: center;
      color: #999;
      padding: 40px;
    }

    /* ================ MODAL (KAYNAK YONETIMI) ================ */
    .modal-content {
      background: #fff;
      border-radius: 10px;
      padding: 20px;
      width: 450px;
      max-width: 90%;
      max-height: 85vh;
      overflow-y: auto;
    }
    .modal-content h2 { margin-top: 0; font-size: 18px; }
    .modal-content label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      margin: 10px 0 4px;
    }
    .modal-content input {
      width: 100%;
      padding: 8px;
      border: 1px solid #ccc;
      border-radius: 6px;
      font-size: 14px;
    }
    .modal-actions {
      display: flex;
      gap: 8px;
      margin-top: 16px;
    }
    .modal-actions button { flex: 1; }

    .source-list-title {
      margin-top: 20px;
      font-size: 13px;
      font-weight: 600;
      border-top: 1px solid #eee;
      padding-top: 12px;
    }
    .source-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 6px 0;
      font-size: 13px;
      border-bottom: 1px solid #f0f0f0;
    }
    .source-row button {
      background: none;
      font-size: 15px;
      padding: 2px 6px;
    }

    /* ================ HABER TAKIP (KEYWORD) STILLERI ================ */
    .tracking-panel {
      grid-column: 1 / -1;
      background: #fff;
      border-radius: 10px;
      padding: 16px;
      margin-bottom: 6px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.08);
    }
    body.dark-mode .tracking-panel { background: #1e1e1e; }

    .tracking-input-row {
      display: flex;
      gap: 8px;
      margin-bottom: 12px;
    }
    .tracking-input-row input {
      flex: 1;
      padding: 8px 10px;
      border: 1px solid #ccc;
      border-radius: 6px;
      font-size: 14px;
    }
    body.dark-mode .tracking-input-row input {
      background: #2a2a2a;
      color: #e8e8e8;
      border-color: #444;
    }

    .tracking-keyword-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .keyword-chip {
      background: #eef1f4;
      color: #333;
      padding: 6px 10px;
      border-radius: 16px;
      font-size: 13px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    body.dark-mode .keyword-chip {
      background: #2a2a2a;
      color: #e8e8e8;
    }
    .chip-remove {
      background: none;
      border: none;
      cursor: pointer;
      font-size: 12px;
      padding: 0 2px;
      color: #999;
    }
    .chip-remove:hover { color: #e04b4b; }
/* ============ HABER TAKİP EŞLEŞME RENKLERİ ============ */

/* Aydınlık modda yakalanan haber */
.news-card.tracked-match {
  background: linear-gradient(135deg, #fff8df 0%, #fff3c4 100%);
  border: 2px solid #f5a623;
  box-shadow: 0 3px 12px rgba(245, 166, 35, 0.25);
  position: relative;
}

/* Kartın sol tarafındaki renkli şerit */
.news-card.tracked-match::before {
  content: "";
  position: absolute;
  top: 10px;
  bottom: 10px;
  left: 0;
  width: 5px;
  background: #f5a623;
  border-radius: 0 5px 5px 0;
}

/* Takip kelimesi etiketi */
.tracked-match-badge {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  flex-wrap: wrap;
  gap: 5px;
  margin: 5px 0;
  padding: 5px 9px;
  border: 1px solid #e6a11e;
  border-radius: 14px;
  background: #ffe5a3;
  color: #754600;
  font-size: 12px;
  font-weight: 600;
}

.tracked-match-badge strong {
  color: #b45f00;
}

.tracked-bell {
  font-size: 13px;
}

/* Karanlık modda yakalanan haber */
body.dark-mode .news-card.tracked-match {
  background: linear-gradient(135deg, #30291b 0%, #3a2e17 100%);
  border-color: #f5a623;
  box-shadow: 0 3px 14px rgba(245, 166, 35, 0.18);
}

body.dark-mode .tracked-match-badge {
  background: #5a4215;
  border-color: #d99416;
  color: #ffd983;
}

body.dark-mode .tracked-match-badge strong {
  color: #ffbe3d;
}

/* Okunmuş olsa bile takip rengi tamamen kaybolmasın */
.news-card.tracked-match.read {
  opacity: 0.72;
}


    /* ============ EKSİK KART STİLLERİ (renderer.js ile uyumlu) ============ */
    .source-logo { width: 18px; height: 18px; border-radius: 4px; object-fit: contain; margin-right: 6px; vertical-align: middle; }
    .source-name { font-size: 12px; font-weight: 600; color: #4a90e2; text-transform: uppercase; margin-right: 8px; }
    .pub-date { font-size: 12px; color: #888; }
    .news-desc { font-size: 13px; color: #555; margin: 8px 0; line-height: 1.4; }
    body.dark-mode .news-desc { color: #bbb; }
    body.dark-mode .pub-date { color: #999; }
    .news-actions { display: flex; justify-content: space-between; align-items: center; margin-top: 10px; }
    .fav-btn { background: none; border: none; cursor: pointer; font-size: 13px; color: #888; padding: 4px 6px; }
    .fav-btn.active { color: #f5a623; font-weight: 600; }
    .read-link { font-size: 13px; color: #4a90e2; text-decoration: none; font-weight: 600; }
    .read-link:hover { text-decoration: underline; }

    /* ============ HABER TAKİP SEKMESİ STİLLERİ ============ */
    .tracking-wrapper {
      grid-column: 1 / -1;
      background: #fff;
      border-radius: 10px;
      padding: 16px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.08);
    }
    body.dark-mode .tracking-wrapper { background: #1e1e1e; }
    .tracked-keywords-list { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
    .remove-kw-btn { background: none; border: none; cursor: pointer; font-size: 12px; color: #999; padding: 0 2px; }
    .remove-kw-btn:hover { color: #e04b4b; }
    .tracking-matches { display: grid; gap: 12px; margin-top: 12px; }
    .match-card { border-left: 4px solid #f5a623; }
    .matched-kw { font-size: 12px; color: #f5a623; font-weight: 600; margin-left: auto; }
  </style>
</head>
<body>

  <!-- ================ UST BAR ================ -->
  <div class="top-bar">
    <h1>📰 Haber Takip</h1>
    <input type="text" id="searchInput" placeholder="🔍 Başlıkta ara..." />
    <select id="sourceFilter">
      <option value="all">Tüm Kaynaklar</option>
    </select>
    <button id="darkModeToggle" class="btn-icon">🌙 Karanlık Mod</button>
    <button id="exportBtn" class="btn-icon">💾 Dışa Aktar</button>
    <button id="addSourceBtn" class="btn-primary">+ Kaynak</button>
  </div>

  <!-- ================ KATEGORI SEKMELERI ================ -->
  <div class="tabs" id="tabs"></div>

  <!-- ================ DURUM CUBUGU ================ -->
  <div id="status">Yükleniyor...</div>

  <!-- ================ HABER LISTESI ================ -->
  <div id="newsList"></div>

  <!-- ================ KAYNAK YONETIM MODALI ================ -->
  <div class="modal-overlay" id="sourceModal">
    <div class="modal-content">
      <h2 id="modalTitle">Yeni Kaynak Ekle</h2>

      <label>Kategori</label>
      <input type="text" id="modalCategory" list="categoryList" placeholder="Örn: Ekonomi" />
      <datalist id="categoryList"></datalist>

      <label>Kaynak Adı</label>
      <input type="text" id="modalName" placeholder="Örn: Hürriyet" />

      <label>RSS URL</label>
      <input type="text" id="modalUrl" placeholder="https://..." />

      <div class="modal-actions">
        <button id="modalCancelBtn">Vazgeç</button>
        <button id="modalSaveBtn" class="btn-primary">Ekle</button>
      </div>

      <div class="source-list-title">Kayıtlı Kaynaklar</div>
      <div id="sourceListContainer"></div>
    </div>
  </div>

  <script src="renderer.js"></script>
</body>
</html>
